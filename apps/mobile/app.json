{
  "expo": {
    "name": "FMBP",
    "slug": "fmbp",
    "scheme": "fmbp",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": { "image": "./assets/splash-icon.png", "resizeMode": "contain", "backgroundColor": "#1F6F5F" },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.fmbp.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "FMBP uses your location to show nearby business opportunities.",
        "NSPhotoLibraryUsageDescription": "FMBP needs photo access to add business and post images.",
        "NSCameraUsageDescription": "FMBP uses the camera to add business and post images."
      }
    },
    "android": {
      "package": "io.fmbp.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#1F6F5F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION", "CAMERA", "READ_MEDIA_IMAGES"],
      "predictiveBackGestureEnabled": false
    },
    "web": { "favicon": "./assets/favicon.png" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      ["expo-location", { "locationWhenInUsePermission": "FMBP uses your location to show nearby business opportunities." }],
      ["expo-image-picker", { "photosPermission": "FMBP needs photo access to add business and post images." }],
      ["expo-notifications", { "color": "#1F6F5F" }]
    ],
    "experiments": { "typedRoutes": true },
    "extra": { "eas": { "projectId": "" } }
  }
}
