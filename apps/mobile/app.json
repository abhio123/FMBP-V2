{
  "expo": {
    "name": "FMBP",
    "slug": "fmbp",
    "scheme": "fmbp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.fmbp.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "FMBP uses your location to show nearby business opportunities.",
        "NSPhotoLibraryUsageDescription": "FMBP needs photo access to add business and post images.",
        "NSCameraUsageDescription": "FMBP uses the camera to add business and post images.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:findmybusinesspartner.net"
      ]
    },
    "android": {
      "package": "io.fmbp.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#1F6F5F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "allowBackup": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "findmybusinesspartner.net",
              "pathPrefix": "/post/"
            },
            {
              "scheme": "https",
              "host": "findmybusinesspartner.net",
              "pathPrefix": "/business/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "FMBP — Find My Business Partner",
      "themeColor": "#1F6F5F"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FMBP uses your location to show nearby business opportunities."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FMBP needs photo access to add business and post images.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1F6F5F"
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1F6F5F",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "a6419f39-f811-4be8-8738-5518d1999bd4"
      },
      "supportEmail": "support@findmybusinesspartner.net",
      "shareBaseUrl": "https://findmybusinesspartner.net"
    },
    "description": "Find My Business Partner: discover and post hyperlocal business opportunities in India.",
    "primaryColor": "#1F6F5F",
    "owner": "fmbp"
  }
}
